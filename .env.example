# Clé d'accès Web3Forms pour le formulaire de contact.
# Obtenir une clé gratuite sur https://web3forms.com/ (aucune création de compte requise).
PUBLIC_WEB3FORMS_KEY=

# --- Keystatic en mode GitHub (à définir dans Netlify, PAS en local) ---
# Dépôt qui reçoit les commits, au format "utilisateur/mon-portfolio".
# Tant que cette variable est vide, Keystatic reste en mode local.
PUBLIC_KEYSTATIC_GITHUB_REPO=
# Les trois suivantes sont générées automatiquement par l'assistant /keystatic/setup.
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=
PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=
