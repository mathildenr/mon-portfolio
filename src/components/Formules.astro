---
import { getEntry } from 'astro:content';
import { exigerFiche } from '../lib/contenu';

const formules = exigerFiche(await getEntry('formules', 'formules'), 'formules');
---

<section id="formules" data-reveal>
	<div class="wrap">
		<div class="section-heading">
			<span class="eyebrow">{formules.surtitre}</span>
			<h2 class="section-title">{formules.titre}</h2>
		</div>

		<div class="grid">
			{
				formules.liste.map((formule) => (
					<article class={`formule-card ${formule.mise_en_avant ? 'is-featured' : ''}`}>
						{formule.mise_en_avant && <span class="pill badge">Populaire</span>}
						<span class="formule-icon" aria-hidden="true">
							{formule.icone}
						</span>
						<h3>{formule.nom}</h3>
						<p class="objectif">{formule.objectif}</p>
						<ul>
							{formule.avantages.map((avantage) => (
								<li>{avantage}</li>
							))}
						</ul>
						<a class="pill cta" href="#contact">En discuter</a>
					</article>
				))
			}
		</div>
	</div>
</section>

<style>
	#formules {
		background: #f7f4ec;
	}

	.grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
		gap: 2rem;
		align-items: start;
	}

	.formule-card {
		position: relative;
		border: 1px solid var(--color-border);
		border-radius: 20px;
		padding: 2.5rem 1.8rem;
		background: #fff;
		transition: transform 0.15s ease, box-shadow 0.15s ease;
	}

	.formule-card:hover {
		transform: translateY(-2px);
		box-shadow: 0 8px 20px rgba(27, 42, 74, 0.08);
	}

	.formule-card.is-featured {
		border-color: var(--color-amber);
	}

	@media (min-width: 760px) {
		.formule-card.is-featured {
			margin-top: -1.5rem;
			padding: 3.1rem 2.1rem 2.75rem;
			box-shadow: 0 18px 38px rgba(27, 42, 74, 0.12);
		}

		.formule-card.is-featured:hover {
			box-shadow: 0 22px 44px rgba(27, 42, 74, 0.16);
		}
	}

	.badge {
		position: absolute;
		top: -13px;
		left: 50%;
		transform: translateX(-50%);
		background: var(--color-amber);
		color: var(--color-navy);
		font-size: 0.68rem;
		text-transform: uppercase;
		letter-spacing: 0.04em;
	}

	.formule-icon {
		display: block;
		text-align: center;
		font-size: 2rem;
		line-height: 1;
	}

	@keyframes popIcon {
		0% {
			transform: scale(1) rotate(0deg);
		}
		50% {
			transform: scale(1.25) rotate(-10deg);
		}
		100% {
			transform: scale(1.12) rotate(-6deg);
		}
	}

	.formule-icon:hover {
		animation: popIcon 400ms cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
	}

	.formule-card h3 {
		margin-top: 0.85rem;
		font-size: 1.25rem;
		font-weight: 500;
		text-align: center;
	}

	.objectif {
		margin-top: 0.9rem;
		text-align: center;
		font-size: 0.94rem;
		color: var(--color-muted);
		line-height: 1.5;
		min-height: 3.2em;
	}

	.formule-card ul {
		list-style: none;
		margin: 1.75rem 0 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 0.8rem;
	}

	.formule-card li {
		font-size: 0.9rem;
		line-height: 1.5;
		padding-left: 1.4em;
		position: relative;
	}

	.formule-card li::before {
		content: '';
		position: absolute;
		left: 0;
		top: 0.5em;
		width: 7px;
		height: 7px;
		border-radius: 50%;
		background: var(--color-navy);
	}

	.formule-card .cta {
		display: block;
		text-align: center;
		margin-top: 2rem;
		font-family: var(--font-title);
		font-weight: 500;
		font-size: 0.85rem;
		color: var(--color-navy);
		background: transparent;
		border: 1px solid var(--color-border);
		padding: 0.7em 1.4em;
		transition: border-color 0.15s ease, background 0.15s ease, transform 0.15s ease;
	}

	.formule-card .cta:hover {
		border-color: var(--color-navy);
	}
</style>
