---
// Toujours pointer vers la home (avec ancre) : ces liens doivent
// fonctionner depuis n'importe quelle page du site, pas seulement l'accueil.
const links = [
	{ href: '/#portfolio', label: 'Portfolio' },
	{ href: '/#services', label: 'Services' },
	{ href: '/#formules', label: 'Formules' },
];
---

<div class="bar">
	<div class="wrap bar-inner">
		<a href="/#top" class="logo">mathilde<span class="dot">.</span></a>

		<nav aria-label="Navigation principale">
			{links.map((link) => <a class="nav-link" href={link.href}>{link.label}</a>)}
			<a class="pill cta" href="/#contact">Me contacter</a>
		</nav>
	</div>
</div>

<style>
	.bar {
		position: sticky;
		top: 0;
		z-index: 50;
		background: rgba(255, 253, 249, 0.88);
		backdrop-filter: blur(8px);
		border-bottom: 1px solid var(--color-border-warm);
	}

	.bar-inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		height: 78px;
		gap: 1.5rem;
	}

	.logo {
		font-family: var(--font-title);
		font-weight: 700;
		font-size: 1.3rem;
		letter-spacing: -0.01em;
		text-decoration: none;
		color: var(--color-navy);
	}

	.dot {
		color: var(--color-amber);
		display: inline-block;
		transition: transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
	}

	.logo:hover .dot {
		transform: scale(1.4);
	}

	nav {
		display: flex;
		align-items: center;
		gap: 2rem;
		flex-wrap: wrap;
	}

	.nav-link {
		text-decoration: none;
		font-family: var(--font-title);
		font-weight: 500;
		font-size: 0.92rem;
		color: var(--color-navy);
		background-image: linear-gradient(var(--color-amber), var(--color-amber));
		background-repeat: no-repeat;
		background-position: 0 100%;
		background-size: 0% 2px;
		transition: background-size 0.2s ease;
	}

	.nav-link:hover {
		background-size: 100% 2px;
	}

	.cta {
		background: var(--color-navy);
		color: #fff;
		font-size: 0.85rem;
		padding: 0.6em 1.4em;
		transition: background 0.15s ease, transform 0.15s ease;
	}

	.cta:hover {
		transform: translateY(-1px);
	}

	@media (max-width: 720px) {
		nav {
			gap: 1rem;
		}

		.nav-link {
			display: none;
		}
	}
</style>
