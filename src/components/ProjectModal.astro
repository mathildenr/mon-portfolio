---
// Aperçu d'un projet, en panneau latéral (façon « peek » Notion),
// affiché au clic sur une vignette.
// Une seule instance pour toute la grille : le contenu est injecté
// depuis les data-attributs de la carte cliquée.
---

<dialog id="project-modal" class="project-peek" aria-labelledby="project-modal-title">
	<div class="panel">
		<header class="bar">
			<span class="pill category-pill" data-modal-category></span>
			<button type="button" class="close" data-modal-close aria-label="Fermer l'aperçu">
				<span aria-hidden="true">×</span>
			</button>
		</header>

		<div class="scroller">
			<div class="visual" role="group" aria-roledescription="carrousel" aria-label="Images du projet">
				<div class="stage" data-gallery-stage></div>

				<button type="button" class="nav prev" data-gallery-prev aria-label="Image précédente" hidden>
					<span aria-hidden="true">‹</span>
				</button>
				<button type="button" class="nav next" data-gallery-next aria-label="Image suivante" hidden>
					<span aria-hidden="true">›</span>
				</button>
			</div>

			<div class="dots-bar" data-gallery-bar hidden>
				<div class="dots" data-gallery-dots></div>
				<p class="sr-only" aria-live="polite" data-gallery-status></p>
			</div>

			<div class="body">
				<h3 id="project-modal-title" data-modal-title></h3>
				<p class="description" data-modal-description></p>
				<a class="pill link" data-modal-link href="#" target="_blank" rel="noopener noreferrer">
					Voir le projet <span class="arrow" aria-hidden="true">↗</span>
				</a>
			</div>
		</div>
	</div>
</dialog>

<style>
	.project-peek {
		position: fixed;
		inset: 0 0 0 auto;
		width: min(580px, 100vw - 2rem);
		max-width: none;
		max-height: none;
		height: 100dvh;
		margin: 0;
		padding: 0.75rem 0.75rem 0.75rem 0;
		border: 0;
		background: transparent;
		overflow: visible;
	}

	.project-peek::backdrop {
		background: rgba(27, 42, 74, 0.28);
	}

	.panel {
		display: flex;
		flex-direction: column;
		height: 100%;
		border: 1px solid var(--color-border-warm);
		border-radius: 20px;
		background: #fff;
		color: var(--color-navy);
		box-shadow: -18px 0 50px rgba(27, 42, 74, 0.16);
		overflow: hidden;
	}

	/* Ouverture : glissement depuis la droite */
	.project-peek[open] .panel {
		animation: peek-in 0.32s cubic-bezier(0.22, 1, 0.36, 1);
	}

	.project-peek[open]::backdrop {
		animation: backdrop-in 0.32s ease;
	}

	/* Fermeture */
	.project-peek.is-closing .panel {
		animation: peek-out 0.22s ease forwards;
	}

	.project-peek.is-closing::backdrop {
		animation: backdrop-out 0.22s ease forwards;
	}

	@keyframes peek-in {
		from {
			transform: translateX(102%);
			opacity: 0.6;
		}
	}

	@keyframes peek-out {
		to {
			transform: translateX(102%);
			opacity: 0.4;
		}
	}

	@keyframes backdrop-in {
		from {
			opacity: 0;
		}
	}

	@keyframes backdrop-out {
		to {
			opacity: 0;
		}
	}

	.bar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		padding: 0.9rem 1rem 0.9rem 1.5rem;
		border-bottom: 1px solid var(--color-border-warm);
		background: rgba(255, 255, 255, 0.92);
	}

	.category-pill {
		background: var(--color-badge-bg);
		color: #5a6472;
		font-weight: 400;
		font-size: 0.7rem;
		padding: 0.35em 0.9em;
	}

	.close {
		flex: none;
		width: 2.1rem;
		height: 2.1rem;
		display: grid;
		place-items: center;
		border: 1px solid var(--color-border-warm);
		border-radius: var(--radius-pill);
		background: #fff;
		color: var(--color-navy);
		font-size: 1.35rem;
		line-height: 1;
		cursor: pointer;
		transition: border-color 0.15s ease, color 0.15s ease;
	}

	.close:hover {
		border-color: var(--color-navy);
		color: var(--color-amber);
	}

	.scroller {
		flex: 1;
		overflow-y: auto;
		overscroll-behavior: contain;
	}

	.visual {
		position: relative;
		margin: 0;
		background: var(--color-amber-soft);
	}

	/* Hauteur fixe : les images se succèdent sans faire sauter la mise en page. */
	.stage {
		position: relative;
		height: clamp(220px, 42vh, 420px);
	}

	.stage :global(img) {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: contain;
		opacity: 0;
		transition: opacity 0.35s ease;
	}

	.stage :global(img.is-active) {
		opacity: 1;
	}

	.nav {
		position: absolute;
		top: 50%;
		transform: translateY(-50%);
		width: 2.1rem;
		height: 2.1rem;
		display: grid;
		place-items: center;
		padding: 0;
		border: 1px solid var(--color-border-warm);
		border-radius: var(--radius-pill);
		background: rgba(255, 255, 255, 0.88);
		color: var(--color-navy);
		font-size: 1.3rem;
		line-height: 1;
		cursor: pointer;
		transition: border-color 0.15s ease, color 0.15s ease, background 0.15s ease;
	}

	.nav:hover,
	.nav:focus-visible {
		border-color: var(--color-navy);
		color: var(--color-amber);
		background: #fff;
	}

	.prev {
		left: 0.75rem;
	}

	.next {
		right: 0.75rem;
	}

	/* display: grid l'emporterait sur le [hidden] du navigateur. */
	.nav[hidden] {
		display: none;
	}

	.dots-bar {
		display: flex;
		justify-content: center;
		padding: 0.8rem 1.25rem;
		border-bottom: 1px solid var(--color-border-warm);
		background: #fff;
	}

	.dots-bar[hidden] {
		display: none;
	}

	.dots {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.45rem;
	}

	.dots :global(.gallery-dot) {
		width: 7px;
		height: 7px;
		padding: 0;
		border: 0;
		border-radius: 50%;
		background: var(--color-border-soft);
		cursor: pointer;
		transition: background 0.2s ease, transform 0.2s ease;
	}

	.dots :global(.gallery-dot:hover) {
		background: var(--color-muted);
	}

	.dots :global(.gallery-dot.is-active) {
		background: var(--color-navy);
		transform: scale(1.3);
	}

	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		margin: -1px;
		padding: 0;
		overflow: hidden;
		clip-path: inset(50%);
		white-space: nowrap;
	}

	.body {
		padding: 1.75rem 1.75rem 2.25rem;
	}

	.body h3 {
		font-size: clamp(1.3rem, 2.6vw, 1.7rem);
		font-weight: 500;
	}

	.description {
		margin-top: 0.75rem;
		color: var(--color-muted);
		font-size: 1rem;
	}

	.description:empty {
		display: none;
	}

	.link {
		margin-top: 1.75rem;
		border: 1px solid var(--color-border);
		color: var(--color-navy);
		transition: border-color 0.15s ease, color 0.15s ease;
	}

	.link[hidden] {
		display: none;
	}

	.link:hover {
		border-color: var(--color-amber);
		color: var(--color-amber);
	}

	.link:hover .arrow {
		transform: translate(2px, -2px);
	}

	.arrow {
		color: var(--color-amber);
		font-size: 0.85em;
		display: inline-block;
		transition: transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
	}

	/* Mobile : le panneau remonte depuis le bas */
	@media (max-width: 700px) {
		.project-peek {
			inset: auto 0 0 0;
			width: 100vw;
			height: min(88dvh, 100dvh);
			padding: 0;
		}

		.panel {
			border-radius: 20px 20px 0 0;
			box-shadow: 0 -14px 40px rgba(27, 42, 74, 0.18);
		}

		.project-peek[open] .panel {
			animation-name: sheet-in;
		}

		.project-peek.is-closing .panel {
			animation-name: sheet-out;
		}

		.bar {
			padding-left: 1.25rem;
		}

		.body {
			padding: 1.4rem 1.25rem 2rem;
		}

		.stage {
			height: clamp(200px, 34dvh, 320px);
		}

		.prev {
			left: 0.5rem;
		}

		.next {
			right: 0.5rem;
		}

		@keyframes sheet-in {
			from {
				transform: translateY(102%);
			}
		}

		@keyframes sheet-out {
			to {
				transform: translateY(102%);
			}
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.project-peek[open] .panel,
		.project-peek[open]::backdrop,
		.project-peek.is-closing .panel,
		.project-peek.is-closing::backdrop {
			animation: none;
		}

		.stage :global(img) {
			transition: none;
		}
	}
</style>

<script>
	const modal = document.getElementById('project-modal') as HTMLDialogElement | null;

	if (modal) {
		const stageEl = modal.querySelector<HTMLElement>('[data-gallery-stage]')!;
		const prevBtn = modal.querySelector<HTMLButtonElement>('[data-gallery-prev]')!;
		const nextBtn = modal.querySelector<HTMLButtonElement>('[data-gallery-next]')!;
		const barEl = modal.querySelector<HTMLElement>('[data-gallery-bar]')!;
		const dotsEl = modal.querySelector<HTMLElement>('[data-gallery-dots]')!;
		const statusEl = modal.querySelector<HTMLElement>('[data-gallery-status]')!;
		const categoryEl = modal.querySelector<HTMLElement>('[data-modal-category]')!;
		const titleEl = modal.querySelector<HTMLElement>('[data-modal-title]')!;
		const descriptionEl = modal.querySelector<HTMLElement>('[data-modal-description]')!;
		const linkEl = modal.querySelector<HTMLAnchorElement>('[data-modal-link]')!;
		const visualEl = modal.querySelector<HTMLElement>('.visual')!;
		const scrollerEl = modal.querySelector<HTMLElement>('.scroller')!;
		const panelEl = modal.querySelector<HTMLElement>('.panel')!;

		const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
		const CLOSE_MS = 220;

		let lastTrigger: HTMLElement | null = null;
		let closing = false;

		// --- Carrousel : visuel principal, puis les images de la galerie ---
		let images: string[] = [];
		let index = 0;

		const showSlide = (next: number) => {
			if (images.length === 0) return;

			index = (next + images.length) % images.length;

			stageEl.querySelectorAll('img').forEach((img, i) => {
				img.classList.toggle('is-active', i === index);
				img.setAttribute('aria-hidden', String(i !== index));
			});

			dotsEl.querySelectorAll('button').forEach((dot, i) => {
				dot.classList.toggle('is-active', i === index);
				dot.setAttribute('aria-current', String(i === index));
			});

			if (images.length > 1) {
				statusEl.textContent = `Image ${index + 1} sur ${images.length}`;
			}
		};

		const buildGallery = (list: string[], titre: string) => {
			images = list;
			index = 0;
			stageEl.replaceChildren();
			dotsEl.replaceChildren();

			const multiple = list.length > 1;

			list.forEach((src, i) => {
				const img = document.createElement('img');
				img.src = src;
				img.alt = multiple ? `${titre} — image ${i + 1} sur ${list.length}` : titre;
				img.loading = i === 0 ? 'eager' : 'lazy';
				stageEl.append(img);
			});

			prevBtn.hidden = !multiple;
			nextBtn.hidden = !multiple;
			barEl.hidden = !multiple;

			if (multiple) {
				list.forEach((_, i) => {
					const dot = document.createElement('button');
					dot.type = 'button';
					dot.className = 'gallery-dot';
					dot.setAttribute('aria-label', `Aller à l'image ${i + 1}`);
					dot.addEventListener('click', () => showSlide(i));
					dotsEl.append(dot);
				});
			}

			showSlide(0);
		};

		const readGallery = (value: string | undefined): string[] => {
			if (!value) return [];
			try {
				const parsed = JSON.parse(value);
				return Array.isArray(parsed) ? parsed.filter((src) => typeof src === 'string' && src) : [];
			} catch {
				return [];
			}
		};

		const open = (card: HTMLElement) => {
			const { titre = '', categorie = '', image = '', lien = '', description = '', couleur = '' } =
				card.dataset;

			buildGallery([image, ...readGallery(card.dataset.galerie)].filter(Boolean), titre);
			categoryEl.textContent = categorie;
			titleEl.textContent = titre;
			descriptionEl.textContent = description;
			visualEl.style.background = couleur || '';

			if (lien) {
				linkEl.href = lien;
				linkEl.hidden = false;
			} else {
				linkEl.removeAttribute('href');
				linkEl.hidden = true;
			}

			scrollerEl.scrollTop = 0;
			lastTrigger = card;
			modal.showModal();
			document.body.style.overflow = 'hidden';
		};

		const dismiss = () => {
			if (closing) return;

			if (prefersReducedMotion) {
				modal.close();
				return;
			}

			closing = true;
			modal.classList.add('is-closing');
			window.setTimeout(() => modal.close(), CLOSE_MS);
		};

		document.querySelectorAll<HTMLElement>('.project-card').forEach((card) => {
			card.addEventListener('click', () => open(card));
		});

		modal.querySelector('[data-modal-close]')?.addEventListener('click', dismiss);

		prevBtn.addEventListener('click', () => showSlide(index - 1));
		nextBtn.addEventListener('click', () => showSlide(index + 1));

		// Flèches du clavier, tant qu'on ne tabule pas dans les pastilles.
		modal.addEventListener('keydown', (event) => {
			if (images.length < 2) return;

			if (event.key === 'ArrowLeft') {
				event.preventDefault();
				showSlide(index - 1);
			} else if (event.key === 'ArrowRight') {
				event.preventDefault();
				showSlide(index + 1);
			}
		});

		// Glissement au doigt sur mobile.
		let touchStartX = 0;
		let touchStartY = 0;

		stageEl.addEventListener(
			'touchstart',
			(event) => {
				touchStartX = event.changedTouches[0].clientX;
				touchStartY = event.changedTouches[0].clientY;
			},
			{ passive: true },
		);

		stageEl.addEventListener(
			'touchend',
			(event) => {
				if (images.length < 2) return;

				const deltaX = event.changedTouches[0].clientX - touchStartX;
				const deltaY = event.changedTouches[0].clientY - touchStartY;

				// On ignore les gestes verticaux, qui servent à faire défiler le panneau.
				if (Math.abs(deltaX) > 45 && Math.abs(deltaX) > Math.abs(deltaY)) {
					showSlide(deltaX < 0 ? index + 1 : index - 1);
				}
			},
			{ passive: true },
		);

		// Clic en dehors du panneau : on ferme.
		modal.addEventListener('click', (event) => {
			if (!panelEl.contains(event.target as Node)) dismiss();
		});

		// Échap : on laisse l'animation de sortie se jouer.
		modal.addEventListener('cancel', (event) => {
			if (closing) return;
			event.preventDefault();
			dismiss();
		});

		modal.addEventListener('close', () => {
			modal.classList.remove('is-closing');
			closing = false;
			document.body.style.overflow = '';
			lastTrigger?.focus();
			lastTrigger = null;
		});
	}
</script>
