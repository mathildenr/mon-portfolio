---
const WEB3FORMS_ACCESS_KEY = import.meta.env.PUBLIC_WEB3FORMS_KEY ?? '';
---

<section id="contact" data-reveal>
	<div class="wrap contact-wrap">
		<div class="contact-intro">
			<span class="eyebrow">À votre écoute</span>
			<h2 class="section-title">Parlons de votre projet</h2>
			<p class="intro">
				Vous avez le projet d'un flyer, d'une revue ou d'une vidéo ? Échangeons sur
				votre besoin.
			</p>
		</div>

		<form id="contact-form" class="contact-form" novalidate>
			<input type="hidden" name="access_key" value={WEB3FORMS_ACCESS_KEY} />
			<input type="hidden" name="subject" value="Nouveau message depuis le portfolio" />
			<input type="checkbox" name="botcheck" class="honeypot" tabindex="-1" autocomplete="off" />

			<label>
				Nom
				<input type="text" name="name" required />
			</label>
			<label>
				Email
				<input type="email" name="email" required />
			</label>
			<label>
				Message
				<textarea name="message" rows="4" required></textarea>
			</label>
			<button type="submit" class="pill submit-btn">Envoyer</button>
			<p class="form-status" role="status" aria-live="polite"></p>
		</form>
	</div>
</section>

<style>
	#contact {
		background: var(--color-navy);
		color: #fff;
	}

	.contact-wrap {
		max-width: 960px;
		display: flex;
		gap: 4rem;
		flex-wrap: wrap;
	}

	.contact-intro {
		flex: 1 1 280px;
	}

	.eyebrow {
		display: inline-block;
		font-family: var(--font-title);
		font-weight: 600;
		font-size: 0.78rem;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--color-amber-soft);
	}

	.section-title {
		margin-top: 0.8rem;
		font-size: clamp(1.9rem, 3vw, 2.5rem);
	}

	.intro {
		margin-top: 1.2rem;
		max-width: 36ch;
		opacity: 0.85;
		font-size: 1.02rem;
		line-height: 1.6;
	}

	.contact-form {
		flex: 1 1 320px;
		display: flex;
		flex-direction: column;
		gap: 1.2rem;
		text-align: left;
	}

	label {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		font-family: var(--font-title);
		font-weight: 500;
		font-size: 0.85rem;
		text-transform: uppercase;
		letter-spacing: 0.02em;
	}

	input,
	textarea {
		font-family: var(--font-body);
		font-size: 1rem;
		padding: 0.75em 1em;
		border-radius: 12px;
		border: none;
		background: #fff;
		color: var(--color-navy);
		resize: vertical;
	}

	input:focus,
	textarea:focus {
		outline: 3px solid var(--color-amber);
	}

	.submit-btn {
		align-self: flex-start;
		margin-top: 0.3rem;
		border: none;
		cursor: pointer;
		background: var(--color-amber);
		color: var(--color-navy);
		padding: 0.85em 2.3em;
	}

	.submit-btn:hover {
		background: var(--color-amber-soft);
	}

	.honeypot {
		display: none;
	}

	.form-status {
		min-height: 1.4em;
		margin: 0;
		font-size: 0.9rem;
	}

	.form-status[data-state='success'] {
		color: var(--color-amber-soft);
	}

	.form-status[data-state='error'] {
		color: #ff8b8b;
	}

	@media (max-width: 640px) {
		.contact-intro,
		.contact-form {
			text-align: center;
		}

		label {
			text-align: left;
		}

		.submit-btn {
			align-self: center;
		}
	}
</style>

<script>
	const form = document.querySelector<HTMLFormElement>('#contact-form');
	const status = form?.querySelector<HTMLParagraphElement>('.form-status');
	const submitBtn = form?.querySelector<HTMLButtonElement>('.submit-btn');

	form?.addEventListener('submit', async (event) => {
		event.preventDefault();
		if (!status || !submitBtn) return;

		const accessKey = (form.elements.namedItem('access_key') as HTMLInputElement)?.value;
		if (!accessKey) {
			status.dataset.state = 'error';
			status.textContent =
				"Le formulaire n'est pas encore configuré. Contactez-moi directement par email.";
			return;
		}

		submitBtn.disabled = true;
		status.dataset.state = '';
		status.textContent = 'Envoi en cours…';

		try {
			const response = await fetch('https://api.web3forms.com/submit', {
				method: 'POST',
				headers: { Accept: 'application/json', 'Content-Type': 'application/json' },
				body: JSON.stringify(Object.fromEntries(new FormData(form).entries())),
			});
			const result = await response.json();

			if (response.ok && result.success) {
				status.dataset.state = 'success';
				status.textContent = 'Merci ! Votre message a bien été envoyé.';
				form.reset();
			} else {
				throw new Error(result.message ?? 'Envoi impossible');
			}
		} catch {
			status.dataset.state = 'error';
			status.textContent = "Une erreur est survenue. Réessayez ou écrivez-moi directement par email.";
		} finally {
			submitBtn.disabled = false;
		}
	});
</script>
