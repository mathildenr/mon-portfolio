---
import { getEntry } from 'astro:content';
import { decouperAccroche } from '../lib/texte';

const hero = (await getEntry('hero', 'hero'))!.data;
const accroche = decouperAccroche(hero.accroche);
---

<header class="hero" id="top" data-reveal>
	<div class="icon-band" aria-hidden="true"></div>

	<div class="wrap hero-body">
		<div class="hero-photo">
			<div class="photo-blob" aria-hidden="true"></div>
			<img class="photo" src={hero.portrait} alt="Portrait de Mathilde" width="223" height="300" fetchpriority="high" />
		</div>

		<div class="hero-text">
			<span class="badge">{hero.badge}</span>

			<h1>{hero.titre}</h1>

			<p class="tagline">
				{
					accroche.map((fragment) =>
						fragment.type === 'saut' ? (
							<br />
						) : fragment.type === 'accent' ? (
							<span class="highlight">{fragment.valeur}</span>
						) : (
							fragment.valeur
						),
					)
				}
			</p>

			<p class="subtext">{hero.sous_titre}</p>

			<div class="cta-row">
				<a class="cta-primary" href="#contact">{hero.bouton_principal}</a>
				<a class="cta-secondary" href="#portfolio">{hero.bouton_secondaire}</a>
			</div>
		</div>
	</div>
</header>

<style>
	.hero {
		position: relative;
		padding-top: 2.5rem;
	}

	.hero-body {
		position: relative;
		z-index: 1;
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 3rem;
		padding-top: 3.5rem;
		padding-bottom: 4rem;
	}

	.hero-photo {
		position: relative;
		flex: 0 0 auto;
		width: 220px;
		height: 220px;
	}

	.photo-blob {
		position: absolute;
		inset: 20px 20px -20px -20px;
		background: var(--color-amber-soft);
		border-radius: 28px;
		z-index: 0;
	}

	.photo {
		position: relative;
		z-index: 1;
		width: 100%;
		height: 100%;
		object-fit: cover;
		border-radius: 28px;
		box-shadow: 0 20px 45px rgba(27, 42, 74, 0.14);
	}

	.hero-text {
		flex: 0 1 605px;
		min-width: 260px;
		text-align: left;
	}

	.badge {
		display: inline-block;
		font-family: var(--font-title);
		font-weight: 600;
		font-size: 0.78rem;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--color-amber-badge-text);
		background: var(--color-amber-badge-bg);
		padding: 0.5em 1.1em;
		border-radius: var(--radius-pill);
		margin-bottom: 1.25rem;
	}

	h1 {
		font-size: clamp(2.2rem, 3.8vw, 3.2rem);
		color: var(--color-navy);
	}

	.tagline {
		margin-top: 1rem;
		font-family: var(--font-title);
		font-weight: 500;
		font-size: clamp(1.15rem, 1.9vw, 1.4rem);
		line-height: 1.45;
		color: var(--color-navy-soft);
	}

	.highlight {
		background: var(--color-amber-soft);
		padding: 0 0.2em;
		box-decoration-break: clone;
		-webkit-box-decoration-break: clone;
	}

	.subtext {
		margin-top: 1.4rem;
		font-size: 1.02rem;
		line-height: 1.6;
		color: var(--color-muted);
	}

	.cta-row {
		display: flex;
		gap: 1rem;
		margin-top: 2.5rem;
		flex-wrap: wrap;
	}

	.cta-primary,
	.cta-secondary {
		display: inline-block;
		text-decoration: none;
		font-family: var(--font-title);
		font-weight: 500;
		font-size: 0.9rem;
		border-radius: var(--radius-pill);
		padding: 0.9em 2em;
		transition: transform 0.15s ease, background 0.15s ease, border-color 0.15s ease;
	}

	.cta-primary {
		background: var(--color-navy);
		color: #fff;
		letter-spacing: 0.02em;
	}

	.cta-secondary {
		border: 1px solid var(--color-border-soft);
		color: var(--color-navy);
	}

	.cta-primary:hover,
	.cta-secondary:hover {
		transform: translateY(-1px);
	}

	@media (max-width: 720px) {
		.hero-body {
			flex-direction: column;
			text-align: center;
			gap: 2rem;
		}

		.hero-text {
			flex-basis: auto;
		}

		.tagline,
		.subtext {
			max-width: none;
		}

		.cta-row {
			justify-content: center;
		}
	}
</style>
