---
const year = new Date().getFullYear();
---

<footer>
	<p>
		© {year} Mathilde Regaud Nardeux - Communication &amp; graphisme
		<span class="sep" aria-hidden="true">|</span>
		<a class="legal-link" href="/mentions-legales">Mentions légales</a>
	</p>
</footer>

<style>
	footer {
		padding: 2.5rem 1.5rem;
		text-align: center;
		font-size: 0.82rem;
		color: #8a93a6;
		background: #fff;
	}

	footer p {
		margin: 0;
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		align-items: center;
		gap: 0.5rem;
	}

	.sep {
		color: #c7cdd6;
	}

	.legal-link {
		color: #8a93a6;
		text-decoration: underline;
		text-underline-offset: 2px;
		transition: color 0.15s ease;
	}

	.legal-link:hover {
		color: var(--color-navy);
	}
</style>
