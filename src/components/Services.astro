---
import { getEntry } from 'astro:content';

const services = (await getEntry('services', 'services'))!.data;
---

<section id="services" data-reveal>
	<div class="wrap">
		<div class="section-heading">
			<span class="eyebrow">{services.surtitre}</span>
			<h2 class="section-title">{services.titre}</h2>
		</div>

		<div class="grid">
			{
				services.liste.map((service) => (
					<article class="service-card">
						<div class="service-icon" aria-hidden="true">{service.icone}</div>
						<h3>{service.titre}</h3>
						<p>{service.description}</p>
						<div class="outils">
							{service.outils.map((outil) => (
								<span class="pill outil-pill">{outil}</span>
							))}
						</div>
					</article>
				))
			}
		</div>
	</div>
</section>

<style>
	.grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
		gap: 1.5rem;
	}

	.service-card {
		border: 1px solid var(--color-border-warm);
		border-radius: 18px;
		padding: 2.25rem 1.85rem;
		background: #fff;
		transition: transform 0.15s ease, box-shadow 0.15s ease;
	}

	.service-card:hover {
		transform: translateY(-2px);
		box-shadow: 0 8px 20px rgba(27, 42, 74, 0.08);
	}

	.service-icon {
		width: 48px;
		height: 48px;
		border-radius: 12px;
		background: var(--color-amber-soft);
		display: flex;
		align-items: center;
		justify-content: center;
		font-size: 1.4rem;
	}

	@keyframes wiggle {
		0%,
		100% {
			transform: rotate(0deg) scale(1);
		}
		25% {
			transform: rotate(-10deg) scale(1.1);
		}
		75% {
			transform: rotate(10deg) scale(1.1);
		}
	}

	.service-icon:hover {
		animation: wiggle 500ms ease;
	}

	.service-card h3 {
		margin-top: 1.4rem;
		font-size: 1.12rem;
		font-weight: 500;
	}

	.service-card p {
		margin-top: 0.9rem;
		color: var(--color-muted);
		font-size: 0.94rem;
		line-height: 1.6;
	}

	.outils {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin-top: 1.5rem;
	}

	.outil-pill {
		background: var(--color-badge-bg);
		color: #5a6472;
		font-weight: 400;
		font-size: 0.68rem;
		padding: 0.32em 0.85em;
	}
</style>
